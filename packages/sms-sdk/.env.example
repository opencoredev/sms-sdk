# Copy to .env and fill in the providers you use. Never commit real values.
# Example numbers below are placeholders, not working senders.

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=
# Or use an API key instead of the auth token:
# TWILIO_API_KEY_SID=SK00000000000000000000000000000000
# TWILIO_API_KEY_SECRET=
TWILIO_FROM=+15005550006
# Or send through a Messaging Service:
# TWILIO_MESSAGING_SERVICE_SID=MG00000000000000000000000000000000

# Telnyx (https://portal.telnyx.com)
TELNYX_API_KEY=
TELNYX_FROM=+15005550007
# Required for alphanumeric senders; optional otherwise:
# TELNYX_MESSAGING_PROFILE_ID=
# Webhook verification: Keys & Credentials > Public Key (base64)
TELNYX_PUBLIC_KEY=

# Plivo (https://console.plivo.com)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM=+15005550008
# Or send through a Powerpack:
# PLIVO_POWERPACK_UUID=

# Vonage Messages API (https://dashboard.nexmo.com)
# Basic auth (no webhooks):
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Or JWT auth with an application (needed for status and inbound webhooks):
# VONAGE_APPLICATION_ID=
# VONAGE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
VONAGE_FROM=+447700900001
# Webhook verification: Dashboard > Settings > Signature secret
VONAGE_SIGNATURE_SECRET=

# Opt-in live tests (send real, billable messages)
# LIVE_SMS_TESTS=true
# LIVE_SMS_TO=+14155550123
# LIVE_SMS_ALLOWLIST=+14155550123
