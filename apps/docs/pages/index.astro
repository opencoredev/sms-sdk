---
// Landing page. Direction: the warm dark palette and DM Sans of leodev.cv,
// widened into a full page. One signature element: the example run, which
// plays a real fallback (Twilio rejects the sender, Telnyx accepts) next to a
// phone. Dark by default; the nav's theme toggle switches it to the light
// palette below, the same warm paper as the docs' light mode (theme.css).
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;
const repoUrl = "https://github.com/opencoredev/sms-sdk";
const npmUrl = "https://www.npmjs.com/package/@opencoredev/sms-sdk";

// `check:snippets` type-checks every `const …Example` template literal on this
// page against the SDK source, so this sample can't drift from the real API.
const sendExample = `import { createSmsClient } from "@opencoredev/sms-sdk";
import { twilio } from "@opencoredev/sms-sdk/twilio";
import { telnyx } from "@opencoredev/sms-sdk/telnyx";

const sms = createSmsClient({
  adapters: [
    twilio({
      accountSid: process.env.TWILIO_ACCOUNT_SID ?? "",
      authToken: process.env.TWILIO_AUTH_TOKEN ?? "",
      from: "+15550100001",
    }),
    telnyx({
      apiKey: process.env.TELNYX_API_KEY ?? "",
      from: "+15550100002",
    }),
  ],
  fallback: "on-known-rejection",
});

const result = await sms.send({
  to: "+14155550123",
  body: "Your order has shipped.",
});

console.log(result.provider); // "telnyx"`;

// Which lines light up at each step of the example run (1-based, inclusive).
const stepLines: [step: number, from: number, to: number][] = [
  [1, 7, 11],
  [2, 12, 15],
  [0, 20, 23],
  [3, 25, 25],
];

const escapeHtml = (text: string) => text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");

// A small highlighter for this one sample: comments, strings, keywords, calls,
// and object keys. Shiki would add a second color scheme to keep in sync.
const highlight = (line: string) => {
  const comment = line.indexOf("//");
  const code = comment === -1 ? line : line.slice(0, comment);
  const tail = comment === -1 ? "" : `<span class="c">${escapeHtml(line.slice(comment))}</span>`;
  const html = escapeHtml(code)
    .replace(/"[^"]*"/g, (match) => `<span class="s">${match}</span>`)
    .replace(/\b(import|from|const|await)\b(?![^<]*<\/span>)/g, '<span class="k">$1</span>')
    .replace(/\b([a-zA-Z]+)(?=\()(?![^<]*<\/span>)/g, '<span class="f">$1</span>')
    .replace(/^(\s+)([a-zA-Z]+)(?=:)/, '$1<span class="p">$2</span>');
  return html + tail;
};

const sendLines = sendExample.split("\n").map((text, index) => {
  const number = index + 1;
  const step = stepLines.find(([, from, to]) => number >= from && number <= to)?.[0];
  return { html: highlight(text) || " ", step };
});

// The provider switcher shows each adapter's options. They are read from this
// sample, which check:snippets type-checks, so a renamed option fails CI.
const providersExample = `import { twilio } from "@opencoredev/sms-sdk/twilio";
import { telnyx } from "@opencoredev/sms-sdk/telnyx";
import { plivo } from "@opencoredev/sms-sdk/plivo";
import { vonage } from "@opencoredev/sms-sdk/vonage";
import { bandwidth } from "@opencoredev/sms-sdk/bandwidth";
import { sinch } from "@opencoredev/sms-sdk/sinch";

const from = "+15550100001";
twilio({ accountSid: "", authToken: "", from });
telnyx({ apiKey: "", from });
plivo({ authId: "", authToken: "", from });
vonage({ apiKey: "", apiSecret: "", from });
bandwidth({ userId: "", apiToken: "", apiSecret: "", applicationId: "", from });
sinch({ servicePlanId: "", apiToken: "", from });`;

const optionsFor = (id: string) => {
  const call = providersExample.match(new RegExp(`^${id}\\(\\{ (.*) \\}\\);$`, "m"))?.[1];
  if (!call) throw new Error(`providersExample has no ${id}() call`);
  const keys = call.split(", ").map((pair) => pair.split(":")[0]);
  return `{ ${keys.join(", ")} }`;
};

const providers = [
  { id: "twilio", name: "Twilio", logo: "/providers/color/twilio.svg" },
  { id: "telnyx", name: "Telnyx", logo: "/providers/color/telnyx.svg" },
  // Plivo, Vonage, and Sinch publish black marks with white versions for dark
  // backgrounds.
  { id: "plivo", name: "Plivo", logo: "/providers/color/plivo.svg", logoDark: "/providers/color/plivo-dark.svg" },
  { id: "vonage", name: "Vonage", logo: "/providers/color/vonage.svg", logoDark: "/providers/color/vonage-dark.svg" },
  { id: "bandwidth", name: "Bandwidth", logo: "/providers/color/bandwidth.svg" },
  { id: "sinch", name: "Sinch", logo: "/providers/color/sinch.svg", logoDark: "/providers/color/sinch-dark.svg" },
].map((provider) => ({ logoDark: provider.logo, ...provider, args: optionsFor(provider.id) }));

// Mirrors isFallbackEligible() in packages/sms-sdk/src/core/errors.ts.
const outcomes = [
  { tone: "ok", title: "Accepted", tag: "resolves", body: "You get the result. Nothing else is tried." },
  { tone: "next", title: "Blocked sender, auth, or rate limit", tag: "falls back", body: "The next provider is tried. A rate limit is retried on the same provider first." },
  { tone: "no", title: "Bad number or opted out", tag: "throws", body: "Another provider would reject it too, so it stops here." },
  { tone: "wait", title: "Timeout or unknown outcome", tag: "throws", body: "The text may already be on its way, so it is never retried." },
];

const features = [
  { href: "/sending/length-and-cost", title: "Segments and encoding", body: "See the cost before you send. One emoji can turn one segment into two." },
  { href: "/receiving/webhooks", title: "Status webhooks", body: "Delivery updates from all six providers in one event shape, checked before your code reads them." },
  { href: "/receiving/webhooks#replies", title: "Inbound SMS", body: "Replies to your numbers arrive as message.received events." },
  { href: "/receiving/opt-outs", title: "STOP and HELP", body: "Opt-outs and help requests come through as their own events." },
  { href: "/sending/idempotency", title: "Idempotency", body: "Pass an idempotencyKey and a store, and a retried job returns the first result instead of texting twice." },
  { href: "/reference/testing", title: "Testing", body: "An in-memory adapter, so tests never send a real text." },
];

const footerColumns = [
  {
    title: "Learn",
    links: [
      { label: "Quick start", href: "/getting-started/quick-start" },
      { label: "Fallback", href: "/sending/fallback-and-retries" },
      { label: "Webhooks", href: "/receiving/webhooks" },
      { label: "Migrate from Twilio", href: "/migration/migrate-from-twilio" },
    ],
  },
  {
    title: "Providers",
    links: providers.map((provider) => ({ label: provider.name, href: `/providers/${provider.id}` })),
  },
  {
    title: "Project",
    links: [
      { label: "GitHub", href: repoUrl },
      { label: "npm", href: npmUrl },
      { label: "Changelog", href: "/reference/changelog" },
      { label: "Switch providers", href: "/migration/switch-providers" },
    ],
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode="dark"
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: "SMS SDK: one TypeScript SDK for SMS providers", description: config.description }}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500&family=JetBrains+Mono:wght@400&display=swap"
  />

  <div class="home">
    <div class="wrap">
      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title">One <code>send()</code> for every SMS provider.</h1>
        <p class="lede">
          A typed TypeScript client for Twilio, Telnyx, Plivo, Vonage, Bandwidth, and Sinch. It tells you which provider took
          each text, or why none did.
        </p>
        <div class="actions">
          <button type="button" class="prompt" data-prompt aria-label="Copy quick start prompt for your agent">
            <span class="agents" aria-hidden="true">
              <i class="agent claude"></i><i class="agent chatgpt"></i><i class="agent grok"></i><i class="agent cursor"></i>
            </span>
            <span class="prompt-label">
              <span>Copy quick start prompt</span>
              <span class="prompt-done">Copied to clipboard</span>
            </span>
          </button>
          <a class="docs u" href="/getting-started/quick-start">Read the docs</a>
          <span class="sr-only" data-prompt-status role="status"></span>
        </div>
      </section>

      <section class="run" aria-label="An example send where Twilio rejects the sender and Telnyx accepts the message">
        <div class="run-top">
          <span class="run-file">send.ts</span>
          <span>example run</span>
          <button type="button" class="replay" data-replay>
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2.5 8a5.5 5.5 0 1 0 1.6-3.9M2.5 2.5v3h3"></path></svg>
            Replay
          </button>
        </div>
        <div class="run-body">
          <div class="run-code">
            <pre>{sendLines.map((line) => (
              <span class="ln" data-step={line.step} set:html={line.html} />
            ))}</pre>
          </div>
          <div class="run-recv">
            <div class="phone">
              <div class="phone-top"><span>+1 (415) 555-0123</span><span class="mono">sms_01JQ8Z3T7K</span></div>
              <div class="bubble" data-bubble>Your order has shipped.</div>
              <div class="status" data-status aria-live="polite"></div>
            </div>
            <ol class="route">
              <li data-step="1"><span class="route-pv">Twilio</span><span class="route-st no">Rejected<em>sender</em></span></li>
              <li data-step="2"><span class="route-pv">Telnyx</span><span class="route-st ok">Accepted<em>queued</em></span></li>
              <li data-step="3"><span class="route-pv">Webhook</span><span class="route-st ok">Delivered<em>message.delivered</em></span></li>
            </ol>
          </div>
        </div>
      </section>

      <section class="section" id="providers" aria-labelledby="providers-title">
        <h2 id="providers-title">Use the provider you already pay for.</h2>
        <p class="sub">
          Every provider is a separate import that returns the same result, so moving from one to another doesn't touch the
          rest of your code.
        </p>
        <div class="switch" role="tablist" aria-label="Providers">
          {providers.map((provider, index) => (
            <button
              type="button"
              class="tab"
              role="tab"
              id={`tab-${provider.id}`}
              aria-controls="provider-panel"
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              data-provider={provider.id}
              data-name={provider.name}
              data-args={provider.args}
            >
              <img class="logo-light" src={provider.logo} alt="" width="26" height="26" />
              <img class="logo-dark" src={provider.logoDark} alt="" width="26" height="26" />
              <span>{provider.name}</span>
            </button>
          ))}
        </div>
        <div class="import-line" id="provider-panel" role="tabpanel" aria-labelledby="tab-twilio">
          <pre data-import></pre>
          <a class="hint u" data-guide href="/providers/twilio">Twilio guide</a>
        </div>
      </section>

      <section class="section" aria-labelledby="fallback-title">
        <h2 id="fallback-title">If one provider says no, the next one gets a try.</h2>
        <p class="sub">
          Fallback is off until you set <code>fallback: "on-known-rejection"</code>. Then it only moves on when a
          rejection is safe to send elsewhere. When the outcome is unknown, it stops, so nobody gets the same text twice. <a class="u strong" href="/sending/fallback-and-retries">How fallback decides</a>
        </p>
        <div class="outcomes">
          {outcomes.map((outcome) => (
            <div class="outcome">
              <i class={`dot ${outcome.tone}`}></i>
              <b>{outcome.title}</b>
              <span class="tag">{outcome.tag}</span>
              <p>{outcome.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="section" aria-labelledby="features-title">
        <h2 id="features-title">Webhooks, opt-outs, and tests are already built.</h2>
        <p class="sub">The parts every SMS integration ends up writing by hand.</p>
        <div class="index">
          {features.map((feature) => (
            <a href={feature.href}>
              <b>{feature.title}<span aria-hidden="true">→</span></b>
              <p>{feature.body}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>

  <footer slot="footer" class="home-footer">
    <div class="wrap">
      <div class="footer-main">
        <div class="footer-brand">
          <div class="footer-name">SMS SDK</div>
          <p>One typed send() for six SMS providers. MIT licensed, with no runtime dependencies.</p>
        </div>
        {footerColumns.map((column) => (
          <div class="footer-col">
            <b>{column.title}</b>
            {column.links.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        ))}
      </div>
      <div class="footer-bottom">
        <span>© 2026 OpenCore</span>
        <span>Built by <a class="u" href="https://leodev.cv">Leo</a></span>
      </div>
    </div>
  </footer>
</PageLayout>

<style>
  .home,
  .home-footer {
    --bg: #121110;
    --surface: #181715;
    --line: #262420;
    --line-2: #34312c;
    --text: #e9e6df;
    --muted: #8f8c84;
    --dim: #8a867d;
    --rule: #4a4741;
    --ok: #8fbf8a;
    --no: #d98a7e;
    --wait: #d8c79b;
    --hover: #1e1d1a;
    --glow: #1f1d1a;
    --tab-on: #4a4640;
    --bubble: #2b2925;
    --bubble-sent: #3a5a3c;
    --line-on: rgba(217, 151, 87, 0.08);
    --line-on-edge: #d97757;
    --code: #d6d2c9;
    --code-k: #d39e8a;
    --code-s: #cdbb8c;
    --code-f: #b7c7d6;
    --code-p: #a9b8a0;
    --prompt-top: #24221f;
    --prompt-bottom: #1c1b18;
    --prompt-border: #45413b;
    --prompt-border-hover: #615c54;
    --prompt-shine: rgba(255, 255, 255, 0.05);
    --agent-ring: #201e1b;
    --sans: "DM Sans", ui-sans-serif, system-ui, sans-serif;
    --mono: "JetBrains Mono", ui-monospace, monospace;
    background: var(--bg);
    color: var(--text);
    font: 400 16px/1.6 var(--sans);
  }
  /* Light mode: the docs' paper palette (theme.css) and the light code colors
     (themes/sms-light.ts). Every text color meets 4.5:1 on --bg and --surface. */
  :global(:root[data-theme="light"]) :is(.home, .home-footer) {
    --bg: #f7f5f0;
    --surface: #f1eee7;
    --line: #e3dfd6;
    --line-2: #d4cfc4;
    --text: #1c1a17;
    --muted: #6b6760;
    --dim: #6f6a62;
    --rule: #b9b3a8;
    --ok: #3d7442;
    --no: #a8473b;
    --wait: #8a5a1f;
    --hover: #e9e5dc;
    --glow: #e9e5dc;
    --tab-on: #8f887c;
    --bubble: #e6e1d6;
    --bubble-sent: #cfe2c9;
    --line-on: rgba(217, 119, 87, 0.12);
    --line-on-edge: #c4613f;
    --code: #1c1a17;
    --code-k: #9a4a2e;
    --code-s: #7a5f1a;
    --code-f: #2f5577;
    --code-p: #4d6440;
    --prompt-top: #fdfcfa;
    --prompt-bottom: #f3f0ea;
    --prompt-border: #d4cfc4;
    --prompt-border-hover: #b9b3a8;
    --prompt-shine: rgba(255, 255, 255, 0.7);
    --agent-ring: #f9f8f4;
  }
  /* Only the provider mark for the current theme shows. */
  .tab .logo-light {
    display: none;
  }
  :global(:root[data-theme="light"]) .tab .logo-light {
    display: block;
  }
  :global(:root[data-theme="light"]) .tab .logo-dark {
    display: none;
  }
  .home :is(h1, h2, b, p, button),
  .home-footer :is(b, p, a, span, div) {
    font-family: var(--sans);
  }
  .home a,
  .home-footer a {
    color: inherit;
    text-decoration: none;
  }
  .home button {
    font: inherit;
    color: inherit;
  }
  .home code,
  .home pre,
  .mono {
    font-family: var(--mono);
  }
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .u {
    text-decoration: underline !important;
    text-decoration-color: var(--rule) !important;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s;
  }
  .u:hover {
    text-decoration-color: var(--text) !important;
  }
  .u.strong {
    color: var(--text);
  }

  /* Hero */
  .hero {
    padding: 104px 0 64px;
  }
  h1 {
    font-weight: 500;
    font-size: 56px;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0 0 22px;
    max-width: 720px;
  }
  h1 code {
    font-weight: 400;
    font-size: 0.84em;
    letter-spacing: -0.03em;
  }
  .lede {
    font-size: 18px;
    color: var(--muted);
    max-width: 540px;
    margin: 0 0 36px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .prompt {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 0 20px 0 12px;
    border-radius: 12px;
    border: 1px solid var(--prompt-border);
    background: linear-gradient(var(--prompt-top), var(--prompt-bottom));
    box-shadow: inset 0 1px 0 var(--prompt-shine);
    cursor: pointer;
    font-size: 15px;
    transition:
      border-color 0.15s,
      transform 0.1s;
  }
  .prompt:hover {
    border-color: var(--prompt-border-hover);
  }
  .prompt:active {
    transform: scale(0.98);
  }
  .prompt:focus-visible,
  .tab:focus-visible,
  .replay:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }
  .agents {
    display: flex;
  }
  .agent {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    box-shadow: 0 0 0 2px var(--agent-ring);
    position: relative;
  }
  .agent + .agent {
    margin-left: -7px;
  }
  .agent::after {
    content: "";
    position: absolute;
    inset: 6px;
    background: currentColor;
    mask: var(--mark) center / contain no-repeat;
  }
  .claude {
    background: #d97757;
    color: #fff;
    --mark: url("/agents/claude.svg");
  }
  .chatgpt {
    background: #f2f1ee;
    color: #0d0d0d;
    --mark: url("/agents/chatgpt.svg");
  }
  /* The ChatGPT mark's light tile needs an edge on paper. */
  :global(:root[data-theme="light"]) .chatgpt {
    box-shadow:
      0 0 0 2px var(--agent-ring),
      inset 0 0 0 1px var(--line-2);
  }
  .grok {
    background: #000;
    color: #fff;
    box-shadow:
      0 0 0 2px var(--agent-ring),
      inset 0 0 0 1px #3a3733;
    --mark: url("/agents/grok.svg");
  }
  .cursor {
    background: #26251f;
    color: #edecec;
    --mark: url("/agents/cursor.svg");
  }
  .prompt-label {
    position: relative;
    white-space: nowrap;
  }
  .prompt-label > span {
    transition: opacity 0.15s;
  }
  .prompt-done {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    color: var(--ok);
  }
  .prompt[data-copied] .prompt-label > span:first-child {
    opacity: 0;
  }
  .prompt[data-copied] .prompt-done {
    opacity: 1;
  }
  .docs {
    font-size: 15px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Example run */
  .run {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    overflow: hidden;
  }
  .run-top {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 46px;
    padding: 0 18px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }
  .run-file {
    color: var(--text);
  }
  .replay {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--muted) !important;
    font-size: 13px !important;
    padding: 6px 8px;
    border-radius: 7px;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .replay:hover {
    color: var(--text) !important;
    background: var(--hover);
  }
  .run-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .run-body > div {
    padding: 26px 28px 30px;
    min-width: 0;
  }
  .run-body > div + div {
    border-left: 1px solid var(--line);
  }
  .home pre {
    margin: 0;
    font-size: 13px;
    line-height: 1.85;
    color: var(--code);
    overflow-x: auto;
    background: none;
    padding: 0;
    border: 0;
  }
  .ln {
    display: block;
    margin: 0 -28px;
    padding: 0 28px;
    transition: background 0.3s;
  }
  .ln.on {
    background: var(--line-on);
    box-shadow: inset 2px 0 0 var(--line-on-edge);
  }
  .home :global(.k) {
    color: var(--code-k);
  }
  .home :global(.s) {
    color: var(--code-s);
  }
  .home :global(.f) {
    color: var(--code-f);
  }
  .home :global(.p) {
    color: var(--code-p);
  }
  .home :global(.c) {
    color: var(--dim);
