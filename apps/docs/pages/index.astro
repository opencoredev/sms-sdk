---
// Landing page. The page owns its header and footer; docs pages keep Blume's
// chrome. Paintings from one winter series frame the page: the valley opens
// it, the railway junction carries the switch, the harbour sits beside the
// outcomes ledger, and the post office at dusk closes it into the footer.
// The page makes three promises: one API across providers, no guessing about
// a send, and local testing.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

import CodeCard from "../landing/CodeCard.astro";

// The segment counter uses the SDK's own estimator, on the server for the
// first paint and in the browser as you type, so the page and sms.validate()
// can never disagree.
import { estimateSegments } from "../../../packages/sms-sdk/src/core/encoding.ts";

const { config } = data;
const repoUrl = "https://github.com/opencoredev/sms-sdk";
const githubMark =
  '<path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>';

const navLinks = [
  { label: "Docs", href: "/getting-started/overview" },
  { label: "Providers", href: "/providers/overview" },
  { label: "Examples", href: "/examples/overview" },
  { label: "Changelog", href: "/community/changelog" },
];

// Every provider list on the page (lede, matrix, footer, meta description)
// comes from this array. Statuses mirror each adapter's `support` value and
// the provider pages. A new adapter is one entry here.
type Status = "supported" | "partial";
type Provider = {
  name: string;
  href: string;
  /** Send, delivery status, inbound, signature check. */
  cells: readonly [Status, Status, Status, Status];
  /** Why a partial cell is partial, in the provider's own terms. */
  note?: string;
  /** Rendered on the page. Off until the adapter ships on this branch. */
  enabled: boolean;
};
const allProviders: Provider[] = [
  { name: "Twilio", href: "/providers/twilio", cells: ["supported", "supported", "supported", "supported"], enabled: true },
  { name: "Telnyx", href: "/providers/telnyx", cells: ["supported", "supported", "supported", "supported"], enabled: true },
  {
    name: "Plivo",
    href: "/providers/plivo#support-status",
    cells: ["partial", "supported", "supported", "partial"],
    note: "Plivo documents no API error body and no timestamp in callback signatures, so most rejections never fall back and replay protection relies on your dedupe.",
    enabled: true,
  },
  {
    name: "Vonage",
    href: "/providers/vonage#support-status",
    cells: ["partial", "partial", "partial", "partial"],
    note: "Vonage does not document the HTTP status for each error code, and the adapter has no short codes or MMS.",
    enabled: true,
  },
  // Sinch and Bandwidth wait on the leo-709-sinch-bandwidth merge (statuses
  // confirmed at 2069e81). Set `enabled: true` once those adapters are on
  // this branch.
  {
    name: "Sinch",
    href: "/providers/sinch",
    cells: ["supported", "supported", "supported", "partial"],
    note: "Callback auth depends on the deployment, so the adapter verifies HMAC when configured and otherwise requires an authenticated boundary plus dedupe.",
    enabled: false,
  },
  {
    name: "Bandwidth",
    href: "/providers/bandwidth",
    cells: ["supported", "supported", "supported", "partial"],
    note: "Bandwidth documents no callback signature, so the adapter checks optional Basic auth and requires dedupe.",
    enabled: false,
  },
];
const providers = allProviders.filter((provider) => provider.enabled);
const providerNames = providers.map((provider) => provider.name);
const providerList = new Intl.ListFormat("en", { type: "disjunction" }).format(providerNames);
const capabilities = [
  { long: "Send", short: "Send" },
  { long: "Delivery status", short: "Status" },
  { long: "Inbound", short: "Inbound" },
  { long: "Signature check", short: "Signature" },
];
const pageDescription = `One TypeScript SDK for SMS. Send through ${providerList} with one typed API, safe fallback, and no runtime dependencies.`;

// Landing samples are checked by check:snippets. Lines marked
// `// [!code hide]` declare the credentials a sample takes as given: they are
// type-checked and copied, but never rendered (see landing/CodeCard.astro).
// Each `*NarrowExample` is the phone shape of a sample, written to fit 390px
// without wrapping.
const sendExample = `import { createSmsClient } from "@opencoredev/sms-sdk";
import { twilio } from "@opencoredev/sms-sdk/twilio";
const accountSid = process.env.TWILIO_ACCOUNT_SID ?? ""; // [!code hide]
const authToken = process.env.TWILIO_AUTH_TOKEN ?? ""; // [!code hide]
const from = "+15550100001"; // [!code hide]

const sms = createSmsClient({
  adapters: [twilio({ accountSid, authToken, from })],
});

await sms.send({ to: "+14155550123", body: "Your order has shipped." });`;

const sendNarrowExample = `import { createSmsClient } from "@opencoredev/sms-sdk"; // [!code hide]
import { twilio } from "@opencoredev/sms-sdk/twilio"; // [!code hide]
const accountSid = process.env.TWILIO_ACCOUNT_SID ?? ""; // [!code hide]
const authToken = process.env.TWILIO_AUTH_TOKEN ?? ""; // [!code hide]
const from = "+15550100001"; // [!code hide]
const sms = createSmsClient({
  adapters: [twilio({
    accountSid, authToken, from,
  })],
});

await sms.send({
  to: "+14155550123",
  body: "Your order has shipped.",
});`;

const switchExample = `import { createSmsClient } from "@opencoredev/sms-sdk";
import { twilio } from "@opencoredev/sms-sdk/twilio"; // [!code --]
import { telnyx } from "@opencoredev/sms-sdk/telnyx"; // [!code ++]
const apiKey = process.env.TELNYX_API_KEY ?? ""; // [!code hide]
const from = "+15550100001"; // [!code hide]

export const sms = createSmsClient({
  adapters: [twilio({ accountSid, authToken, from })], // [!code --]
  adapters: [telnyx({ apiKey, from })], // [!code ++]
});`;

const switchNarrowExample = `import { createSmsClient } from "@opencoredev/sms-sdk"; // [!code hide]
import { telnyx } from "@opencoredev/sms-sdk/telnyx"; // [!code hide]
const apiKey = process.env.TELNYX_API_KEY ?? ""; // [!code hide]
const from = "+15550100001"; // [!code hide]
export const sms = createSmsClient({
  adapters: [twilio({ // [!code --]
    accountSid, authToken, from, // [!code --]
  })], // [!code --]
  adapters: [telnyx({ apiKey, from })], // [!code ++]
});`;

const testingExample = `import { createSmsClient } from "@opencoredev/sms-sdk";
import { memory } from "@opencoredev/sms-sdk/testing";

const outbox = memory();
const sms = createSmsClient({ adapters: [outbox] });

await sms.send({ to: "+14155550123", body: "Test message" });

outbox.sent.length; // 1, and nothing left the process
outbox.sent[0]?.message.body; // "Test message"
outbox.reset();`;

const testingNarrowExample = `import { createSmsClient } from "@opencoredev/sms-sdk"; // [!code hide]
import { memory } from "@opencoredev/sms-sdk/testing"; // [!code hide]
const outbox = memory();
const sms = createSmsClient({
  adapters: [outbox],
});

await sms.send({
  to: "+14155550123",
  body: "Test message",
});

outbox.sent.length; // 1
outbox.sent[0]?.message.body;
outbox.reset();`;

const samples = [
  { label: "Short", body: "Your order has shipped." },
  {
    label: "With an emoji",
    body: "Your appointment with Dr. Lee is tomorrow at 9:30 AM at 22 Market St. Reply C to confirm or R to reschedule 🙂",
  },
  {
    label: "Long",
    body: "Your appointment with Dr. Lee is tomorrow at 9:30 AM at 22 Market St. Reply C to confirm or R to reschedule. Please arrive 10 minutes early to fill in the check-in forms.",
  },
];
const initialBody = samples[1]?.body ?? "";
const initial = estimateSegments(initialBody);
const initialCells = Array.from({ length: initial.segments }, (_, index) =>
  Math.min(1, (initial.units - index * initial.unitsPerSegment) / initial.unitsPerSegment),
);
const encodingLabel = (encoding: string) => (encoding === "gsm7" ? "GSM-7" : "UCS-2");

// Each outcome maps to the SDK's real result and error types.
const outcomes = [
  {
    tone: "ok",
    status: "Sent",
    name: "Accepted",
    code: `handoff: "accepted"`,
    body: "The provider created or queued the message. You get its ID to match delivery webhooks.",
  },
  {
    tone: "next",
    status: "Next provider",
    name: "Known rejection",
    code: "fallbackEligible: true",
    body: "Auth, rate limit, sender, or account. With fallback on, the next adapter tries. Rate limits retry first and honor Retry-After.",
  },
  {
    tone: "stop",
    status: "Stops",
    name: "Rejected message",
    code: "fallbackEligible: false",
    body: "A recipient, compliance, or request problem. Another provider would refuse it too, so the send stops.",
  },
  {
    tone: "hold",
    status: "Stops, tells you",
    name: "Unknown outcome",
    code: "HandoffUnknownError",
    body: "A timeout, network failure, or 5xx after the request left. No retry and no fallback, so nobody gets the text twice. Reconcile first.",
  },
];

const footerColumns = [
  {
    title: "Docs",
    links: [
      { label: "Quick start", href: "/getting-started/quick-start" },
      { label: "Sending", href: "/sending/overview" },
      { label: "Receiving", href: "/receiving/overview" },
      { label: "Reference", href: "/reference/create-sms-client" },
    ],
  },
  {
    title: "Providers",
    links: providers.map((provider) => ({ label: provider.name, href: provider.href.split("#")[0] ?? provider.href })),
  },
  {
    title: "Project",
    links: [
      { label: "GitHub", href: repoUrl },
      { label: "npm", href: "https://www.npmjs.com/package/@opencoredev/sms-sdk" },
      { label: "Changelog", href: "/community/changelog" },
      { label: "Contributing", href: "/community/contributing" },
    ],
  },
];

const art = (name: string) => ({
  src: `/art/${name}.webp`,
  srcset: `/art/${name}-760.webp 760w, /art/${name}.webp 1264w`,
});
---

<PageLayout
  site={{ title: config.title, description: pageDescription }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: "SMS SDK: one TypeScript SDK for SMS providers", description: pageDescription }}
>
  <div class="sms-landing">
    <header class="sms-nav" data-sms-nav>
      <div class="sms-nav-inner">
        <a class="sms-wordmark" href="/" aria-label="SMS SDK home">SMS SDK</a>
        <nav class="sms-nav-links" aria-label="Main">
          {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        <div class="sms-nav-actions">
          {
            config.search.enabled && (
              <button type="button" class="sms-icon-btn" data-sms-search aria-label="Search the docs" title="Search (Ctrl K)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
              </button>
            )
          }
          <a class="sms-icon-btn sms-hide-sm" href={repoUrl} aria-label="SMS SDK on GitHub">
            <svg viewBox="0 0 16 16" class="sms-mark" aria-hidden="true" set:html={githubMark} />
          </a>
          <button type="button" class="sms-icon-btn sms-hide-sm" data-blume-theme-toggle aria-label="Toggle dark mode">
            <svg viewBox="0 0 24 24" class="sms-sun" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg viewBox="0 0 24 24" class="sms-moon" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          </button>
          <a class="sms-btn sms-btn-primary sms-btn-sm sms-nav-cta" href="/getting-started/quick-start">Get started</a>
          <button
            type="button"
            class="sms-icon-btn sms-menu-btn"
            data-sms-menu
            aria-expanded="false"
            aria-controls="sms-menu"
            aria-label="Menu"
          >
            <svg viewBox="0 0 24 24" class="sms-open" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg viewBox="0 0 24 24" class="sms-close" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </div>
      </div>
      <div class="sms-menu" id="sms-menu" hidden>
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href={repoUrl}>GitHub</a>
        <div class="sms-menu-row">
          <button type="button" class="sms-btn" data-blume-theme-toggle>
            <span class="sms-sun-label">Dark mode</span><span class="sms-moon-label">Light mode</span>
          </button>
        </div>
      </div>
    </header>

    <section class="sms-hero" aria-labelledby="hero-title">
      <div class="sms-hero-art sms-art" aria-hidden="true">
        <img {...art("winter-valley")} sizes="100vw" width="1264" height="848" alt="" fetchpriority="high" />
      </div>
      <div class="sms-hero-copy">
        <h1 id="hero-title">One send call across SMS&nbsp;providers</h1>
        <p class="sms-lede">
          Send through {providerList} with one typed API. Fallback stays off until you turn it&nbsp;on.
        </p>
        <div class="sms-ctas">
          <a class="sms-btn sms-btn-primary sms-btn-lg" href="/getting-started/quick-start" data-sms-hero-cta>Get started</a>
          <button type="button" class="sms-install" data-sms-copy="npm i @opencoredev/sms-sdk" aria-label="Copy install command">
            <span class="sms-install-prompt" aria-hidden="true">$</span>
            <code>npm i @opencoredev/sms-sdk</code>
            <svg class="sms-copy-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
            <svg class="sms-check-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          </button>
        </div>
      </div>
      <div class="sms-hero-code">
        <CodeCard title="send.ts" code={sendExample} narrow={sendNarrowExample} />
      </div>
    </section>

    <section class="sms-wrap sms-promise sms-switch" aria-labelledby="switch-title">
      <figure class="sms-switch-art sms-art">
        <img
          {...art("winter-junction")}
          sizes="(min-width: 64rem) 32rem, 100vw"
          width="1264"
          height="848"
          alt="An oil painting of a snowy railway junction at first light: a switch lever beside the rails, a lamp on a post, and a signal cabin."
          loading="lazy"
        />
      </figure>
      <div class="sms-switch-body">
        <h2 id="switch-title">Change providers without touching your&nbsp;app</h2>
        <p class="sms-section-lede">
          Swap the adapter and every <code>sms.send()</code> call stays the same. Your number, its
          registration, and webhook URLs belong to each provider account, so set those up first.
        </p>
        <CodeCard title="sms.ts" code={switchExample} narrow={switchNarrowExample} class="sms-diff-card" />
        <p class="sms-more"><a class="sms-link" href="/migration/switch-twilio-to-telnyx">Switching guide</a></p>
      </div>
    </section>

    <section class="sms-wrap sms-providers" aria-labelledby="providers-title">
      <div class="sms-providers-head">
        <h3 class="sms-h3" id="providers-title">The same call runs on every adapter</h3>
        <p>
          Every adapter is a separate import with no runtime dependencies. Partial means the provider
          leaves some behavior undocumented, so the adapter plays it safe.
        </p>
      </div>
      <table class="sms-matrix">
        <thead>
          <tr>
            <th scope="col"><span class="sms-visually-hidden">Provider</span></th>
            {
              capabilities.map((capability) => (
                <th scope="col">
                  <span class="sms-long">{capability.long}</span>
                  <span class="sms-short">{capability.short}</span>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            providers.map((provider) => (
              <Fragment>
              <tr class:list={[{ "sms-has-note": provider.note !== undefined }]}>
                <th scope="row">{provider.name}</th>
                {provider.cells.map((status) =>
                  status === "supported" ? (
                    <td>
                      <svg class="sms-check" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M3.5 8.5l3 3 6-7" />
                      </svg>
                      <span class="sms-visually-hidden">Supported</span>
                    </td>
                  ) : (
                    <td>
                      <span class="sms-pill">Partial</span>
                    </td>
                  ),
                )}
              </tr>
              {provider.note !== undefined && (
                <tr class="sms-matrix-note">
                  <td colspan={capabilities.length + 1}>{provider.note}</td>
                </tr>
              )}
              </Fragment>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="sms-wrap sms-promise sms-outcomes" aria-labelledby="outcomes-title">
      <div class="sms-outcomes-intro">
        <h2 id="outcomes-title">It never guesses about a send</h2>
        <p class="sms-section-lede">
          Fallback stays off until you turn it on. Then it moves to the next provider only after a
          known rejection. When the SDK can't tell whether a message went out, it stops and tells you.
        </p>
        <p class="sms-more"><a class="sms-link" href="/sending/retries-and-fallback">Retries and fallback</a></p>
        <figure class="sms-outcomes-art sms-art">
          <img
            {...art("winter-harbour")}
            sizes="(min-width: 64rem) 24rem, 100vw"
            width="1264"
            height="848"
            alt="An oil painting of a stone signal house with a lit lantern beside a snowy pier on a frozen harbour."
            loading="lazy"
          />
        </figure>
      </div>
      <ol class="sms-ledger" aria-label="What happens after a send">
        {
          outcomes.map((outcome) => (
            <li class:list={[{ "sms-ledger-hold": outcome.tone === "hold" }]}>
              <p class="sms-ledger-meta">
                <span class="sms-outcome">
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    {outcome.tone === "ok" && <path d="M3.5 8.5l3 3 6-7" />}
                    {outcome.tone === "next" && <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" />}
                    {outcome.tone === "stop" && <path d="M4.5 4.5l7 7M11.5 4.5l-7 7" />}
                    {outcome.tone === "hold" && <path d="M6 4v8M10 4v8" />}
                  </svg>
                  {outcome.status}
                </span>
                <code>{outcome.code}</code>
              </p>
              <h3>{outcome.name}</h3>
              <p>{outcome.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sms-promise sms-local" aria-labelledby="local-title">
      <div class="sms-wrap sms-local-inner">
        <div class="sms-local-head">
          <h2 id="local-title">Test it all on your laptop</h2>
          <p class="sms-section-lede">
            The <code>memory()</code> adapter records sends in process, so tests and CI never text
            anyone. <code>validate()</code> counts segments locally too. Try the counter: it runs the
            SDK's own estimator in your browser.
          </p>
          <p class="sms-more"><a class="sms-link" href="/guides/local-testing">Local testing</a></p>
        </div>
        <div class="sms-local-grid">
          <CodeCard title="send.test.ts" code={testingExample} narrow={testingNarrowExample} class="sms-flat-card" />
          <div class="sms-counter" data-sms-counter>
            <div class="sms-counter-head">
              <label for="sms-counter-body">Message</label>
              <div class="sms-samples" role="group" aria-label="Sample messages">
                {
                  samples.map((sample) => (
                    <button type="button" data-sms-sample={sample.body} aria-pressed={sample.body === initialBody ? "true" : "false"}>
                      {sample.label}
                    </button>
                  ))
                }
              </div>
            </div>
            <textarea id="sms-counter-body" rows="3" maxlength="640" spellcheck="false" data-sms-input>{initialBody}</textarea>
            <div class="sms-track" aria-hidden="true" data-sms-track>
              {
                initialCells.map((fill) => (
                  <span class="sms-track-cell">
                    <span class="sms-track-fill" style={`inline-size: ${(fill * 100).toFixed(1)}%`} />
                  </span>
                ))
              }
            </div>
            <dl class="sms-readout" aria-live="polite">
              <div>
                <dt>Segments</dt>
                <dd data-sms-out="segments">{initial.segments}</dd>
              </div>
              <div>
                <dt>Encoding</dt>
                <dd data-sms-out="encoding">{encodingLabel(initial.encoding)}</dd>
              </div>
              <div>
                <dt>Units</dt>
                <dd data-sms-out="units">{initial.units}</dd>
              </div>
            </dl>
            <p class="sms-counter-note" data-sms-out="note">
              {
                initial.nonGsmCharacters.length > 0
                  ? `UCS-2 because of ${initial.nonGsmCharacters.join(" ")}. ${initial.unitsPerSegment} units per segment.`
                  : `Every character fits GSM-7. ${initial.unitsPerSegment} units per segment.`
              }
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="sms-closing" aria-labelledby="closing-title">
      <div class="sms-closing-art sms-art" aria-hidden="true">
        <img {...art("winter-post-office-dusk")} sizes="100vw" width="1264" height="843" alt="" loading="lazy" />
      </div>
      <div class="sms-closing-copy">
        <h2 id="closing-title">Send your first message</h2>
        <p>Install the package, add one adapter, and call&nbsp;<code>send()</code>.</p>
        <div class="sms-ctas">
          <a class="sms-btn sms-btn-light sms-btn-lg" href="/getting-started/quick-start">Read the quick start</a>
          <a class="sms-btn sms-btn-ghost sms-btn-lg" href={repoUrl}>View on GitHub</a>
        </div>
      </div>
    </section>
  </div>

  <footer class="sms-footer" slot="footer">
    <div class="sms-footer-inner">
      <div class="sms-footer-brand">
        <a class="sms-wordmark" href="/">SMS SDK</a>
        <p>A TypeScript SDK for transactional SMS. MIT licensed, built on fetch, with no runtime dependencies.</p>
      </div>
      <nav class="sms-footer-cols" aria-label="Footer">
        {
          footerColumns.map((column) => (
            <div>
              <h2>{column.title}</h2>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
  </footer>
</PageLayout>

<script>
  import { estimateSegments } from "../../../packages/sms-sdk/src/core/encoding.ts";

  const copyText = async (text: string) => {
    if (navigator.clipboard) {
      await navigator.clipboard.writeText(text);
      return;
    }
    // Plain-HTTP previews are not a secure context and have no Clipboard API.
    const field = document.createElement("textarea");
    field.value = text;
    field.setAttribute("readonly", "");
    field.style.position = "fixed";
    field.style.opacity = "0";
    document.body.append(field);
    field.select();
    document.execCommand("copy");
    field.remove();
  };

  const flash = (button: HTMLElement, label: string) => {
    if (button.dataset.copied !== undefined) return;
    button.dataset.copied = "";
    button.setAttribute("aria-label", "Copied");
    window.setTimeout(() => {
      delete button.dataset.copied;
      button.setAttribute("aria-label", label);
    }, 1600);
  };

  document.addEventListener("click", async (event) => {
    const target = event.target instanceof Element ? event.target : null;

    // Each copy button carries its own text: the install command, or a code
    // sample as it runs (the "after" side of a diff, with no hidden stubs).
    const copyButton = target?.closest<HTMLButtonElement>("[data-sms-copy]");
    if (copyButton) {
      const label = copyButton.getAttribute("aria-label") ?? "Copy";
      await copyText(copyButton.dataset.smsCopy ?? "");
      flash(copyButton, label);
      return;
    }

    // The custom header opens Blume's own search dialog, which lives in the
    // hidden stock header so ⌘K and the index keep working.
    if (target?.closest("[data-sms-search]")) {
      document.querySelector<HTMLButtonElement>("[data-blume-header] [data-blume-search-open]")?.click();
      return;
    }

    const menuButton = target?.closest<HTMLButtonElement>("[data-sms-menu]");
    if (menuButton) {
      const menu = document.getElementById("sms-menu");
      const open = menuButton.getAttribute("aria-expanded") !== "true";
      menuButton.setAttribute("aria-expanded", String(open));
      if (menu) menu.hidden = !open;
    }
  });

  // The header sits over the painting at the top and frosts once the page
  // scrolls. Looked up on each call because the client router swaps the body.
  const syncNav = () =>
    document.querySelector("[data-sms-nav]")?.toggleAttribute("data-scrolled", window.scrollY > 8);
  window.addEventListener("scroll", syncNav, { passive: true });

  const renderCounter = (counter: HTMLElement) => {
    const input = counter.querySelector<HTMLTextAreaElement>("[data-sms-input]");
    const track = counter.querySelector<HTMLElement>("[data-sms-track]");
    if (!input || !track) return;
    const estimate = estimateSegments(input.value);
    track.replaceChildren(
      ...Array.from({ length: Math.max(1, estimate.segments) }, (_, index) => {
        const cell = document.createElement("span");
        cell.className = "sms-track-cell";
        const fill = document.createElement("span");
        fill.className = "sms-track-fill";
        const used = (estimate.units - index * estimate.unitsPerSegment) / estimate.unitsPerSegment;
        fill.style.inlineSize = `${(Math.min(1, Math.max(0, used)) * 100).toFixed(1)}%`;
        cell.append(fill);
        return cell;
      }),
    );
    const values: Record<string, string> = {
      segments: String(estimate.segments),
      encoding: estimate.encoding === "gsm7" ? "GSM-7" : "UCS-2",
      units: String(estimate.units),
      note: `${
        estimate.nonGsmCharacters.length > 0
          ? `UCS-2 because of ${estimate.nonGsmCharacters.join(" ")}.`
          : "Every character fits GSM-7."
      } ${estimate.unitsPerSegment} units per segment.`,
    };
    for (const [name, value] of Object.entries(values)) {
      const node = counter.querySelector(`[data-sms-out="${name}"]`);
      if (node) node.textContent = value;
    }
    counter.querySelectorAll<HTMLButtonElement>("[data-sms-sample]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.smsSample === input.value));
    });
  };

  document.addEventListener("input", (event) => {
    const counter = (event.target instanceof Element ? event.target : null)?.closest<HTMLElement>("[data-sms-counter]");
    if (counter) renderCounter(counter);
  });

  document.addEventListener("click", (event) => {
    const sample = (event.target instanceof Element ? event.target : null)?.closest<HTMLButtonElement>("[data-sms-sample]");
    const counter = sample?.closest<HTMLElement>("[data-sms-counter]");
    const input = counter?.querySelector<HTMLTextAreaElement>("[data-sms-input]");
    if (!sample || !counter || !input) return;
    input.value = sample.dataset.smsSample ?? "";
    renderCounter(counter);
  });

  // On phones the hero has its own Get started button, so the header's copy
  // stays hidden until the hero button has scrolled up past the header.
  let heroCtaObserver: IntersectionObserver | undefined;
  const watchHeroCta = () => {
    heroCtaObserver?.disconnect();
    const nav = document.querySelector("[data-sms-nav]");
    const heroCta = document.querySelector("[data-sms-hero-cta]");
    if (!nav || !heroCta) return;
    heroCtaObserver = new IntersectionObserver(([entry]) => {
      if (entry) nav.toggleAttribute("data-past-hero-cta", !entry.isIntersecting && heroCta.getBoundingClientRect().top < 64);
    }, { rootMargin: "-64px 0px 0px 0px" });
    heroCtaObserver.observe(heroCta);
  };

  document.addEventListener("astro:page-load", () => {
    syncNav();
    watchHeroCta();
  });
  syncNav();
  watchHeroCta();
</script>
