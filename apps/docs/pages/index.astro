</style>

<script>
  /** Copies text and reports whether it worked. */
  const copyText = async (text: string): Promise<boolean> => {
    if (navigator.clipboard) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return false;
      }
    }
    // Plain-HTTP previews are not a secure context and have no Clipboard API.
    const field = document.createElement("textarea");
    field.value = text;
    field.setAttribute("readonly", "");
    field.style.position = "fixed";
    field.style.opacity = "0";
    document.body.append(field);
    field.select();
    const copied = document.execCommand("copy");
    field.remove();
    return copied;
  };

  const quickStartPrompt = () => `Add SMS sending to this app with @opencoredev/sms-sdk.

1. Read ${location.origin}/llms.txt before writing any code.
2. Install it: npm i @opencoredev/sms-sdk
3. Ask me which provider I use (Twilio, Telnyx, Plivo, Vonage, Bandwidth, or Sinch) and read its credentials from environment variables.
4. Create one client with createSmsClient and add a send() call where it fits.
5. Handle the errors send() throws: a rejection can be shown to the user, but an unknown outcome must never be retried automatically.`;

  // The run plays once when it scrolls into view and again on Replay. Each frame
  // lights the matching code lines and moves the phone and the route forward.
  const frames: [delay: number, step: number, status: string][] = [
    [300, 0, "Sending…"],
    [1300, 1, "Twilio rejected the sender, trying Telnyx…"],
    [2300, 2, "Sent via Telnyx"],
    [3400, 3, "Delivered"],
  ];

  const setupHome = () => {
    const promptButton = document.querySelector<HTMLButtonElement>("[data-prompt]");
    const run = document.querySelector<HTMLElement>(".run");
    if (!promptButton || !run) return;

    const promptStatus = document.querySelector<HTMLElement>("[data-prompt-status]");
    let promptTimer = 0;
    promptButton.addEventListener("click", async () => {
      const copied = await copyText(quickStartPrompt());
      if (promptStatus) promptStatus.textContent = copied ? "Prompt copied to clipboard" : "Copy failed";
      if (!copied) return;
      promptButton.dataset.copied = "";
      window.clearTimeout(promptTimer);
      promptTimer = window.setTimeout(() => delete promptButton.dataset.copied, 1800);
    });

    const bubble = run.querySelector<HTMLElement>("[data-bubble]");
    const status = run.querySelector<HTMLElement>("[data-status]");
    const lines = [...run.querySelectorAll<HTMLElement>(".ln[data-step]")];
    const route = [...run.querySelectorAll<HTMLElement>(".route li")];
    let timers: number[] = [];

    const showStep = (step: number, label: string) => {
      lines.forEach((line) => line.classList.toggle("on", Number(line.dataset.step) === step));
      route.forEach((item) => item.classList.toggle("in", Number(item.dataset.step) <= step));
      bubble?.classList.toggle("in", step >= 0);
      bubble?.classList.toggle("sent", step >= 2);
      if (status) status.textContent = label;
    };

    const play = () => {
      timers.forEach((timer) => window.clearTimeout(timer));
      timers = frames.map(([delay, step, label]) => window.setTimeout(() => showStep(step, label), delay));
      showStep(-1, "");
    };

    run.querySelector("[data-replay]")?.addEventListener("click", play);
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      showStep(3, "Delivered");
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries[0]?.isIntersecting) {
            play();
            observer.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      observer.observe(run);
    }

    const tabs = [...document.querySelectorAll<HTMLButtonElement>(".tab")];
    const importLine = document.querySelector<HTMLElement>("[data-import]");
    const guide = document.querySelector<HTMLAnchorElement>("[data-guide]");
    const selectProvider = (tab: HTMLButtonElement) => {
      const { provider = "", name = "", args = "" } = tab.dataset;
      tabs.forEach((other) => {
        other.setAttribute("aria-selected", String(other === tab));
        other.tabIndex = other === tab ? 0 : -1;
      });
      importLine?.parentElement?.setAttribute("aria-labelledby", tab.id);
      if (importLine) {
        importLine.textContent = `import { ${provider} } from "@opencoredev/sms-sdk/${provider}";\n\nadapters: [${provider}(${args})]`;
      }
      if (guide) {
        guide.textContent = `${name} guide`;
        guide.href = `/providers/${provider}`;
      }
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectProvider(tab));
      // Arrow keys, Home, and End move focus and selection together.
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === "ArrowRight" ? (index === last ? 0 : index + 1)
          : event.key === "ArrowLeft" ? (index === 0 ? last : index - 1)
          : event.key === "Home" ? 0
          : event.key === "End" ? last
          : undefined;
        const target = next === undefined ? undefined : tabs[next];
        if (!target) return;
        event.preventDefault();
        target.focus();
        selectProvider(target);
      });
    });
    if (tabs[0]) selectProvider(tabs[0]);
  };

  // ClientRouter swaps pages without a full load, so run setup on every page view.
  document.addEventListener("astro:page-load", setupHome);
</script>
