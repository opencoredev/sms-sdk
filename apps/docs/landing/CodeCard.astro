---
// A landing code sample on a card, with its own copy button.
//
// `code` is the sample exactly as check:snippets type-checks it. Lines marked
// `// [!code hide]` (the credentials a sample takes as given) are type-checked
// and copied but never rendered. `narrow` is the phone shape of the same
// sample, shown under 37.5rem. Copy always copies the wide sample as it runs:
// for a diff, the "after" version.
import CodeBlock from "blume/components/content/CodeBlock.astro";

interface Props {
  title: string;
  code: string;
  narrow?: string;
  class?: string;
}

const { title, code, narrow, class: className } = Astro.props;

const notationLine = /\s*\/\/ \[!code (hide|\+\+)\]$/u;
const visibleLines = (source: string) => source.split("\n").filter((line) => !line.includes("// [!code hide]"));
const copyText = code
  .split("\n")
  .filter((line) => !line.includes("// [!code --]"))
  .map((line) => line.replace(notationLine, ""))
  .join("\n");
const variants =
  narrow === undefined
    ? [{ source: code, only: undefined }]
    : [
        { source: code, only: "sms-only-wide" },
        { source: narrow, only: "sms-only-narrow" },
      ];
---

{
  variants.map((variant) => (
    <div class:list={["sms-card", "sms-code", variant.only, className]}>
      <CodeBlock lang="ts" title={title} code={visibleLines(variant.source).join("\n")} icons={false} />
      <button type="button" class="sms-copy" data-sms-copy={copyText} aria-label="Copy code">
        <svg class="sms-copy-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="9" y="9" width="12" height="12" rx="2" />
          <path d="M5 15V5a2 2 0 0 1 2-2h10" />
        </svg>
        <svg class="sms-check-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
      </button>
    </div>
  ))
}
