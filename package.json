{
  "name": "sms-sdk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@email-sdk/config": "workspace:*",
    "@changesets/cli": "^2.31.1",
    "@changesets/changelog-github": "^0.5.1"
  },
  "scripts": {
    "dev": "bun run --cwd apps/docs dev",
    "build": "bun run --cwd packages/sms-sdk build && bun run --cwd apps/docs build",
    "test": "bun run --cwd packages/sms-sdk test && bun run --cwd apps/docs test",
    "typecheck": "bun run --cwd packages/sms-sdk check-types",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "changeset publish"
  },
  "overrides": {
    "@opentelemetry/propagator-jaeger@>=2.0.0 <2.9.0": "2.9.0",
    "basic-ftp@>=5.0.0 <6.2.1": "6.2.1",
    "follow-redirects@>=1.0.0 <1.16.2": "1.16.2",
    "glob@>=9.0.0 <14.0.2": "14.0.2",
    "mermaid@>=12.0.0 <12.2.0": "12.2.0",
    "minimatch@>=10.0.0 <11.0.1": "11.0.1",
    "minimatch@>=5.0.0 <6.0.0": "11.0.1",
    "path-to-regexp@>=6.0.0 <6.3.0": "6.3.0",
    "postcss-selector-parser@>=6.0.0 <6.1.5": "6.1.5",
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "uuid@>=9.0.0 <11.0.0": "11.1.1"
  },
  "packageManager": "bun@1.4.2"
}
